{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityAndRegionDiscovery",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:DescribeRegions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockReadOnly",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:ListInferenceProfiles",
        "bedrock:ListProvisionedModelThroughputs",
        "bedrock:ListCustomModels",
        "bedrock:ListGuardrails",
        "bedrock:ListTagsForResource",
        "bedrock-agent:ListAgents",
        "bedrock-agent:ListAgentAliases",
        "bedrock-agent:ListKnowledgeBases",
        "bedrock-agent:ListPrompts",
        "bedrock-agent:ListFlows"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SageMakerReadOnly",
      "Effect": "Allow",
      "Action": [
        "sagemaker:ListModels",
        "sagemaker:ListEndpoints",
        "sagemaker:ListEndpointConfigs",
        "sagemaker:ListTrainingJobs",
        "sagemaker:ListProcessingJobs",
        "sagemaker:ListPipelines",
        "sagemaker:ListModelPackages",
        "sagemaker:ListInferenceComponents",
        "sagemaker:ListExperiments",
        "sagemaker:ListDomains",
        "sagemaker:ListUserProfiles",
        "sagemaker:ListApps",
        "sagemaker:ListSpaces",
        "sagemaker:ListProjects",
        "sagemaker:ListFlowDefinitions",
        "sagemaker:ListHumanTaskUis",
        "sagemaker:ListHumanLoops",
        "sagemaker:ListTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManagedAiReadOnly",
      "Effect": "Allow",
      "Action": [
        "rekognition:ListCollections",
        "rekognition:ListStreamProcessors",
        "rekognition:DescribeProjects",
        "textract:ListAdapters",
        "textract:ListAdapterVersions",
        "comprehend:ListEntitiesDetectionJobs",
        "comprehend:ListDocumentClassificationJobs",
        "comprehend:ListSentimentDetectionJobs",
        "comprehend:ListTopicsDetectionJobs",
        "comprehend:ListKeyPhrasesDetectionJobs",
        "comprehend:ListPiiEntitiesDetectionJobs",
        "comprehend:ListDocumentClassifiers",
        "comprehend:ListEntityRecognizers",
        "comprehend:ListEndpoints",
        "comprehend:ListFlywheels",
        "lexv2-models:ListBots",
        "lexv2-models:ListBotAliases",
        "lexv2-models:ListBotLocales",
        "polly:ListLexicons",
        "polly:ListSpeechSynthesisTasks",
        "transcribe:ListTranscriptionJobs",
        "transcribe:ListMedicalTranscriptionJobs",
        "transcribe:ListMedicalScribeJobs",
        "transcribe:ListCallAnalyticsJobs",
        "transcribe:ListVocabularies",
        "transcribe:ListMedicalVocabularies",
        "transcribe:ListLanguageModels",
        "translate:ListTerminologies",
        "translate:ListParallelData",
        "translate:ListTextTranslationJobs",
        "personalize:ListCampaigns",
        "personalize:ListDatasetGroups",
        "personalize:ListDatasets",
        "personalize:ListEventTrackers",
        "personalize:ListFilters",
        "personalize:ListRecommenders",
        "personalize:ListSolutions",
        "kendra:ListIndices",
        "kendra:ListDataSources",
        "kendra:ListFaqs",
        "qbusiness:ListApplications",
        "qbusiness:ListDataSources",
        "qbusiness:ListIndices",
        "qbusiness:ListPlugins",
        "qbusiness:ListRetrievers",
        "frauddetector:GetDetectors",
        "frauddetector:GetModels",
        "frauddetector:ListTagsForResource",
        "forecast:ListDatasetGroups",
        "forecast:ListDatasets",
        "forecast:ListForecasts",
        "forecast:ListMonitors",
        "forecast:ListPredictors",
        "lookoutequipment:ListDatasets",
        "lookoutequipment:ListInferenceSchedulers",
        "lookoutequipment:ListModels",
        "medical-imaging:ListDatastores",
        "medical-imaging:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AiInfrastructureReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeTags",
        "ecs:ListClusters",
        "ecs:DescribeClusters",
        "ecs:ListServices",
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTagsForResource",
        "eks:ListClusters",
        "eks:DescribeCluster",
        "eks:ListNodegroups",
        "eks:DescribeNodegroup",
        "eks:ListTagsForResource",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "es:ListDomainNames",
        "es:DescribeDomains",
        "es:ListTags",
        "redshift:DescribeClusters",
        "redshift:DescribeTags",
        "rds:DescribeDBClusters",
        "rds:ListTagsForResource",
        "neptune:DescribeDBClusters",
        "neptune:ListTagsForResource",
        "glue:ListMLTransforms",
        "glue:GetMLTransform"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApplicationAndTagDiscoveryReadOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions",
        "lambda:ListTags",
        "tagging:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UsageTelemetryReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListMetrics",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReportedCostReadOnly",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetDimensionValues",
        "ce:GetTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ActivityEvidenceReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:LookupEvents"
      ],
      "Resource": "*"
    }
  ]
}
